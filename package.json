{
  "name": "dsh-profile-lab",
  "version": "0.2.0",
  "description": "DSH 临时 profile 实验台：一键从模板或现有 profile 克隆隔离环境、装插件、跑 headless 探针会话、起驻留 web 实例验 HTTP/渲染面、读回会话摘要并安全回收——把「改插件怕把本体改暴毙」这件事变成有护栏的标准动作。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lab": "./lib/lab.js",
    "./sessions": "./lib/sessions.js",
    "./web": "./lib/web.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "profile",
    "sandbox",
    "tmp-profile"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js; node scripts/clean-tmp.mjs",
    "test:live": "node --test tests/live.test.js",
    "selfcheck": "node scripts/selfcheck.mjs"
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  }
}
